{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Top-level contract for findings.json. Enforced directly by validate-findings.cjs.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "A source-grounded reliability or concurrency defect confirmed by deterministic execution.",
        "additionalProperties": false,
        "required": [
          "verdict",
          "fingerprint",
          "fault_unit_ids",
          "title",
          "failure_class",
          "severity",
          "blast_radius",
          "trigger_likelihood",
          "broken_invariant",
          "root_cause",
          "source_trace",
          "reproducer",
          "disprover_notes",
          "minimal_fix",
          "regression_test_strategy"
        ],
        "properties": {
          "verdict": { "type": "string", "const": "confirmed" },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
          },
          "fault_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "title": { "type": "string", "minLength": 1 },
          "failure_class": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "blast_radius": { "type": "string", "minLength": 1 },
          "trigger_likelihood": { "type": "string", "minLength": 1 },
          "broken_invariant": { "type": "string", "minLength": 1 },
          "root_cause": { "type": "string", "minLength": 1 },
          "source_trace": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line_start", "line_end", "symbol", "role"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          },
          "reproducer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "command",
              "test_file",
              "runs_executed",
              "runs_failed",
              "observed_failure_output"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["concurrent_test", "fault_injection", "deterministic_trace"]
              },
              "command": { "type": "string", "minLength": 1 },
              "test_file": { "type": "string", "minLength": 1 },
              "runs_executed": { "type": "integer", "minimum": 1 },
              "runs_failed": { "type": "integer", "minimum": 1 },
              "observed_failure_output": { "type": "string", "minLength": 1 }
            }
          },
          "disprover_notes": { "type": "string", "minLength": 1 },
          "minimal_fix": { "type": "string", "minLength": 1 },
          "regression_test_strategy": { "type": "string", "minLength": 1 }
        }
      },
      {
        "type": "object",
        "description": "A source-grounded candidate whose live failure could not be safely executed locally.",
        "additionalProperties": false,
        "required": [
          "verdict",
          "fingerprint",
          "fault_unit_ids",
          "title",
          "failure_class",
          "severity",
          "broken_invariant",
          "root_cause",
          "source_trace",
          "unresolved_fact",
          "why_blocked",
          "safe_verification_recipe"
        ],
        "properties": {
          "verdict": { "type": "string", "const": "needs_validation" },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
          },
          "fault_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "title": { "type": "string", "minLength": 1 },
          "failure_class": { "type": "string", "minLength": 1 },
          "severity": { "type": "null" },
          "broken_invariant": { "type": "string", "minLength": 1 },
          "root_cause": { "type": "string", "minLength": 1 },
          "source_trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line_start", "line_end", "symbol", "role"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          },
          "unresolved_fact": { "type": "string", "minLength": 1 },
          "why_blocked": { "type": "string", "minLength": 1 },
          "safe_verification_recipe": { "type": "string", "minLength": 1 }
        }
      },
      {
        "type": "object",
        "description": "A candidate disproved by an independent verifier citing a real mitigating guard.",
        "additionalProperties": false,
        "required": [
          "verdict",
          "fingerprint",
          "fault_unit_ids",
          "title",
          "failure_class",
          "severity",
          "disprover_evidence",
          "mitigating_guard_location",
          "rejection_reason"
        ],
        "properties": {
          "verdict": { "type": "string", "const": "rejected" },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
          },
          "fault_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "title": { "type": "string", "minLength": 1 },
          "failure_class": { "type": "string", "minLength": 1 },
          "severity": { "type": "null" },
          "disprover_evidence": { "type": "string", "minLength": 1 },
          "mitigating_guard_location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line_start", "line_end", "symbol"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "symbol": { "type": "string", "minLength": 1 }
            }
          },
          "rejection_reason": { "type": "string", "minLength": 1 }
        }
      }
    ]
  }
}
